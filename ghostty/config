# FONT
font-family = "FiraCode Nerd Font Mono"
# Light / Regular / Retina / Medium / SemiBold / Bold
font-style = Retina
# font-family = "JetBrainsMonoNL NFM Light"
# font-family-bold = "JetBrainsMonoNL NFM Light"
font-size = 14

# THEME
theme = Carbonfox
# theme = light:Nvim Light,dark:nvim-dark-dimmed
background-opacity = 0.95
background-blur = 15
bold-is-bright = true

# CURSOR
cursor-color = #3AE52C
shell-integration-features = no-cursor
cursor-style = underline

macos-titlebar-style = tabs
window-padding-balance = true
window-padding-x = 5
window-padding-y = 5
